{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOM extractor result",
  "type": "object",
  "properties": {
    "modelVersion": { "type": "string" },
    "fields": {
      "type": "object",
      "properties": {
        "title": { "$ref": "#/$defs/field" },
        "body": { "$ref": "#/$defs/field" },
        "date": { "$ref": "#/$defs/dateField" },
        "byline": { "$ref": "#/$defs/field" }
      },
      "required": ["title", "body", "date", "byline"],
      "additionalProperties": false
    },
    "debug": {
      "type": "object",
      "properties": {
        "rejected": {
          "type": "object",
          "properties": {
            "title": { "$ref": "#/$defs/rejected" },
            "body": { "$ref": "#/$defs/rejected" },
            "date": { "$ref": "#/$defs/rejected" },
            "byline": { "$ref": "#/$defs/rejected" }
          },
          "additionalProperties": false
        }
      },
      "required": ["rejected"],
      "additionalProperties": false
    }
  },
  "required": ["modelVersion", "fields"],
  "additionalProperties": false,
  "$defs": {
    "dateField": {
      "type": "object",
      "properties": {
        "text": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "iso": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "html": { "type": "string" },
        "source": {
          "type": "object",
          "properties": { "selector": { "type": "string" } },
          "required": ["selector"],
          "additionalProperties": false
        }
      },
      "required": ["text", "confidence", "iso"],
      "additionalProperties": false
    },
    "field": {
      "type": "object",
      "properties": {
        "text": { "type": ["string", "null"] },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "html": { "type": "string" },
        "source": {
          "type": "object",
          "properties": { "selector": { "type": "string" } },
          "required": ["selector"],
          "additionalProperties": false
        }
      },
      "required": ["text", "confidence"],
      "additionalProperties": false
    },
    "rejected": {
      "type": "object",
      "properties": { "text": { "type": "string" } },
      "required": ["text"],
      "additionalProperties": false
    }
  }
}
